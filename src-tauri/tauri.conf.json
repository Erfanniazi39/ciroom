{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CiRoom",
  "version": "0.1.5",
  "identifier": "app.ciroom.media",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CiRoom",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0A0A0D",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Video",
    "shortDescription": "Personal media center",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../dist/": "dist/",
      "../server/": "server/",
      "../mpv/": "mpv/",
      "runtime/package.json": "package.json"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Erfanniazi39/ciroom/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxMEU2MTFEMkRGQTg3QjkKUldTNWgvb3RIV0VPNGNKczAxUUJOeFJONVlXcUE3Wnk1emNJS2s1RUt3SlBtWmlRN0tqSi9xWTkK"
    }
  }
}
