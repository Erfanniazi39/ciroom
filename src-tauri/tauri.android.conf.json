{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": null,
    "beforeBuildCommand": "npm run build:android",
    "frontendDist": "../dist-android"
  },
  "app": {
    "windows": [
      {
        "title": "CiRoom",
        "backgroundColor": "#0A0A0D",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": null,
    "resources": null
  },
  "plugins": {
    "updater": null
  }
}
