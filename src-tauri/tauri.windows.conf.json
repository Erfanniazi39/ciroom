{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../dist/": "dist/",
      "../server/": "server/",
      "../dev/": "dev/",
      "../mpv/": "mpv/",
      "runtime/package.json": "package.json",
      "windows-bin/": "bin/"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": { "windows": { "installMode": "passive" } }
  }
}
