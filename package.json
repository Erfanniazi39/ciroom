{
  "name": "ciroom",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 vite",
    "build": "tsc -b && vite build && node scripts/build-party.js",
    "build:android": "vite build --config vite.android.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:functional": "node --test \"tests/functional/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:functional && npm run build && npm run test:e2e",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "dev-app": "node scripts/dev-data.js --if-missing && CIROOM_DEV=1 CIROOM_PORT=1430 CIROOM_DATA_DIR=.dev-data/data CIROOM_CACHE_DIR=.dev-data/cache tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev-data": "node scripts/dev-data.js",
    "serve": "NODE_USE_ENV_PROXY=1 node server/index.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "^5.4.11"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-linux-x64-gnu": "^2.12.4"
  }
}
